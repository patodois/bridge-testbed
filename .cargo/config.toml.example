# Copy to .cargo/config.toml (untracked: it holds absolute local paths).
#
# The providers pin rewrite-bridge at 1b58201 but rewrite-bridge-bevy lives at 4340109; without a patch
# Cargo builds two incompatible copies of rewrite-bridge. The library source of the two revisions is
# identical, so both are pointed at one checkout (detached at 4340109):
#   git clone https://github.com/patodois/rewrite-bridge ~/rewrite-bridge-pin
#   git -C ~/rewrite-bridge-pin checkout 4340109034667921f719f7ae1cff36c817604f9b
# Delete this patch once the providers pin a revision that has rewrite-bridge-bevy.
[patch."https://github.com/patodois/rewrite-bridge"]
rewrite-bridge = { path = "/ABSOLUTE/PATH/TO/rewrite-bridge-pin" }
rewrite-bridge-bevy = { path = "/ABSOLUTE/PATH/TO/rewrite-bridge-pin/rewrite-bridge-bevy" }

# The testbed uses the animated ids and level scenes of wf-unpack's `bridge2` branch (e759a20), which is
# not on GitHub yet; Cargo.toml pins main so that the dependency resolves. Remove this patch and pin
# e759a20 in Cargo.toml once the branch is pushed.
[patch."https://github.com/patodois/wf-unpack"]
wf-unpack = { path = "/ABSOLUTE/PATH/TO/wf-unpack-bridge2" }

[build]
jobs = 4
